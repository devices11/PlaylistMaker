<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.PlaylistMaker" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/ys_display</item>
        <item name="fontFamily">@font/ys_display</item>
    </style>

    <style name="TextAppearance.PlaylistMaker.Regular">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="fontFamily">@font/ys_display_regular</item>
    </style>

    <style name="TextAppearance.PlaylistMaker.Medium">
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="fontFamily">@font/ys_display_medium</item>
    </style>

    <style name="TextAppearance.PlaylistMaker.Bold">
        <item name="android:fontFamily">@font/ys_display_bold</item>
        <item name="fontFamily">@font/ys_display_bold</item>
    </style>

    <style name="TextAppearance.PlaylistMaker.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">@dimen/main_button_text_size</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.PlaylistMaker.Button.Big" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="backgroundTint">@color/yp_white</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textColor">@color/yp_black</item>
        <item name="android:textAppearance">@style/TextAppearance.PlaylistMaker.Button</item>
        <item name="rippleColor">@color/button_ripple</item>
        <item name="iconTint">@color/yp_black</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">24dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="SettingsItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">61dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/screen_padding_horizontal</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">@dimen/settings_item_text_size</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="drawableTint">@color/icon_secondary</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
